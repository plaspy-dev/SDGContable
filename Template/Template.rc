/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "&Vista Preliminar",           57609
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 ID_CONFIGURACION_SERVIDORES
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de SDGContable...",   ID_APP_ABOUT
    END
END

IDR_TemplateTYPE MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM "&Abrir...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Guardar\tCtrl+S",            ID_FILE_SAVE
        MENUITEM "Guardar &como...",            ID_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "&Vista Preliminar",           57609
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Deshacer\tCtrl+Z",           ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cor&tar\tCtrl+X",             ID_EDIT_CUT
        MENUITEM "&Copiar\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "&Pegar\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 142
    END
    POPUP "&Ventana"
    BEGIN
        MENUITEM "&Cascada",                    ID_WINDOW_CASCADE
        MENUITEM "&Mosaico",                    ID_WINDOW_TILE_HORZ
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "&Acerca de SDGContable...",   ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL
    "S",            ID_FILE_SAVE,           VIRTKEY, CONTROL
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY 
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Acerca de Template"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "Template versión 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2006",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "Aceptar",IDOK,178,7,50,16,WS_GROUP
END

IDD_TEMPLATE_FORM DIALOGEX 0, 0, 291, 234
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    EDITTEXT        IDC_ENUMERO,54,8,40,14,ES_AUTOHSCROLL
    COMBOBOX        IDC_CDOCUMENTO,54,24,105,30,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_CNOMBRE,54,38,105,30,CBS_DROPDOWN | CBS_SORT | WS_VSCROLL | WS_TABSTOP
    EDITTEXT        IDC_EDIRECCION,54,52,105,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_ETELEFONO,54,67,105,14,ES_AUTOHSCROLL
    CONTROL         "",IDC_LITEMS,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,7,84,277,51
    EDITTEXT        IDC_ESUBTOTAL,228,137,56,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EDESCUENTOI,227,151,56,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EIVA,227,166,56,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_ERETENCION,227,181,56,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_ETOTAL,227,195,56,14,ES_AUTOHSCROLL
    EDITTEXT        IDC_EOBSERVACIONES,12,137,147,14,ES_MULTILINE | ES_AUTOVSCROLL
    PUSHBUTTON      "Aceptar",IDOK,180,213,50,14
    PUSHBUTTON      "Cancelar",IDCANCEL,233,213,50,14
    LTEXT           "Número",IDC_STATIC,12,11,26,8
    LTEXT           "Documento",IDC_STATIC,12,27,37,8
    LTEXT           "Nombre",IDC_STATIC,12,41,26,8
    LTEXT           "Dirección",IDC_STATIC,12,55,30,8
    LTEXT           "Teléfono",IDC_STATIC,12,70,29,8
    LTEXT           "SubTotal",IDC_STATIC,180,140,29,8
    LTEXT           "Descuento",IDC_STATIC,180,154,35,8
    LTEXT           "IVA",IDC_STATIC,180,169,12,8
    LTEXT           "Total",IDC_STATIC,180,198,17,8
    LTEXT           "Retención",IDC_STATIC,180,184,33,8
END


